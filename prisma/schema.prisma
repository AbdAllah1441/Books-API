generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

// user model 
model User {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(USER)
  // A user may have an author profile
  authorProfile Author?

  library   UserBook[]

  createdAt DateTime @default(now())
}

// Author model
model Author {
  id        String   @id @default(uuid())
  name      String
  bio       String?
  books     Book[] 
  // Optional connection to a registered user
  userId String? @unique
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// book model
model Book {
  id          String   @id @default(uuid())
  title       String
  description String?
  isbn        String?  @unique
  publishedAt DateTime?
  pages       Int?
  cover       String?

  author      Author[]    
  genre       String[]

  library     UserBook[]

  createdAt   DateTime @default(now())
}

enum ReadingStatus {
  WANT_TO_READ
  CURRENTLY_READING
  COMPLETED
  ABANDONED
}

model UserBook {
  id        String        @id @default(uuid())

  userId    String
  bookId    String

  status    ReadingStatus @default(WANT_TO_READ)

  rating    Int?
  notes     String?

  currentPage Int         @default(0)
  startedAt DateTime?
  finishedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, bookId])
}
{
  "info": {
    "name": "Library API",
    "description": "Runnable contract for the Pedro Node course Express API: cookie JWT auth plus personal book library.\n\nSynced to Postman workspace `pedro-node-course` (collection uid 60278085-9886ce65-1981-4d8c-ba7d-29246867d89a).\n\n`GET /books` is public. Auth cookie `token` is required for `GET /books/mine` and `POST /books`.",
    "schema": "https://schema.postman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001" },
    { "key": "email", "value": "demo@example.com" },
    { "key": "password", "value": "password123" },
    { "key": "username", "value": "demo_user" },
    { "key": "name", "value": "Demo User" },
    { "key": "bookId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Hello World",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/",
            "description": "Smoke check that the server is up."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns greeting', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('message');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"username\": \"{{username}}\",\n  \"name\": \"{{name}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Create a user. Sets httpOnly `token` cookie on success (201)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created or already exists', function () {",
                  "  pm.expect([201, 400]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.test('Returns user', function () {",
                  "    pm.expect(body.user).to.have.property('id');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Authenticate and set the `token` cookie used by /books/mine and POST /books."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns user without password', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.user).to.include.keys('id', 'email', 'username');",
                  "  pm.expect(body.user).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/logout",
            "description": "Clears the auth cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout ok', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get all available books",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books",
            "description": "Public catalog of all books (no auth). Includes author id/name."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Has books array', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('books');",
                  "  pm.expect(body.books).to.be.an('array');",
                  "});",
                  "if (pm.response.json().books.length > 0) {",
                  "  pm.collectionVariables.set('bookId', pm.response.json().books[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my library",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books/mine",
            "description": "List books in the authenticated user's library. Requires `token` cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authorized library list', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Has books array', function () {",
                  "  pm.expect(pm.response.json()).to.have.property('books');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Add book to library",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"{{bookId}}\",\n  \"status\": \"WANT_TO_READ\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/books",
            "description": "Add an existing Book row to the user's library. Requires `token` cookie and a real bookId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Added or validation error', function () {",
                  "  pm.expect([201, 400, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove book from library",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/books/mine/{{bookId}}",
            "description": "Remove a book from the authenticated user's library by bookId. Requires `token` cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Removed or not in library', function () {",
                  "  pm.expect([200, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my library (unauthenticated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books/mine",
            "description": "Negative check: /books/mine without cookie should be 401."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.cookies.clear();"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rejects missing auth', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}

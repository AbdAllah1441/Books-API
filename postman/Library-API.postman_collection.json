              "raw": "{{baseUrl}}/books/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "mine"
              ]
            },
            "description": "Negative check: /books/mine without cookie should be 401."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.cookies.clear();"
